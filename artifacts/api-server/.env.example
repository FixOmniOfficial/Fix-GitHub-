# ─────────────────────────────────────────────────────────────────
# Fix Omni — API Server Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Local / Replit PostgreSQL (provisioned automatically by Replit)
DATABASE_URL=postgresql://user:pass@localhost:5432/fixomni

# Future: Switch to Supabase by adding SUPABASE_DB_URL in Secrets.
# When present, SUPABASE_DB_URL takes priority over DATABASE_URL.
# Get it from: Supabase Dashboard → Project → Settings → Database → URI
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Clerk Auth ────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
SESSION_SECRET=change-me-in-production
PORT=8080
