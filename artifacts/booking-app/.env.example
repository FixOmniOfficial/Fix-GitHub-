# ─────────────────────────────────────────────────────────────────
# Fix Omni — Booking App Environment Variables
# Copy this file to .env.local and fill in your values.
# All EXPO_PUBLIC_* vars are bundled into the app at build time.
# ─────────────────────────────────────────────────────────────────

# ── API Server ────────────────────────────────────────────────────
# Development (Replit): set automatically by the workspace
# Production (Play Store APK): set to your deployed API URL
EXPO_PUBLIC_API_URL=https://your-api-domain.replit.app

# ── App Environment ───────────────────────────────────────────────
# "development" | "production"
# In EAS Build this is set automatically; in local dev it defaults to development
EXPO_PUBLIC_APP_ENV=development

# ── Optional: Supabase (future) ───────────────────────────────────
# Add these when you're ready to switch from local PostgreSQL → Supabase.
# No code changes needed — just add these in Secrets.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# SUPABASE_URL=https://[project].supabase.co
# SUPABASE_ANON_KEY=your-anon-key
