{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/service-center run build",
  "outputDirectory": "dist/public",
  "env": {
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
            "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
